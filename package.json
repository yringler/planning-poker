{
  "name": "planning-poker",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "concurrently \"npx partykit dev\" \"ng serve\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy:party": "npx partykit deploy"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "mathjs": "^15.1.1",
    "ng2-charts": "^8.0.0",
    "partykit": "^0.0.115",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "y-partykit": "^0.0.33",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.2"
  }
}
