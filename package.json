{
  "name": "planning-poker",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "concurrently \"wrangler dev\" \"ng serve\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false && npm run test:party",
    "test:app": "ng test",
    "test:party": "tsc -p party/tsconfig.spec.json && vitest run --config party/vitest.config.ts",
    "deploy:party": "wrangler deploy",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss}\" \"party/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss}\" \"party/**/*.ts\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@awesome.me/webawesome": "^3.2.1",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "ng2-charts": "^8.0.0",
    "partyserver": "^0.5.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "y-partyserver": "^2.2.0",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "~22.19.0",
    "concurrently": "^9.2.1",
    "jsdom": "~27.4.0",
    "prettier": "3.8.1",
    "typescript": "~5.9.2",
    "vitest": "~4.1.12",
    "wrangler": "^4.154.0",
    "y-protocols": "~1.0.7"
  },
  "overrides": {
    "y-partyserver": {
      "@cloudflare/workers-types": "$@cloudflare/workers-types"
    }
  }
}
